{% extends 'base.html.twig' %}
{% block title %}Livraisons par Zone{% endblock %}
{% block body %}
<h1 class="mb-4"><i class="fas fa-map-marker-alt"></i> Livraisons par Zone</h1>

<div class="row">
    {% for zone in zones %}
        <div class="col-md-3 mb-3">
            <div class="card {% if zone.nb_commandes > 0 %}border-danger{% endif %}">
                <div class="card-body text-center">
                    <h2 class="text-danger">ZONE {{ zone.id }}</h2>
                    <p class="mb-2">
                        <strong>Frais :</strong> {{ zone.prix_livraison|number_format(0, ',', ' ') }} FCFA
                    </p>
                    <div class="alert alert-{{ zone.nb_commandes > 0 ? 'warning' : 'success' }} py-2">
                        <h4 class="mb-0">{{ zone.nb_commandes }}</h4>
                        <small>Commande(s) en attente</small>
                    </div>
                    {% if zone.nb_commandes > 0 %}
                        <a href="{{ path('livraison_zone_details', {id: zone.id}) }}" class="btn btn-danger btn-sm w-100">
                            <i class="fas fa-eye"></i> Voir les commandes
                        </a>
                    {% else %}
                        <button class="btn btn-secondary btn-sm w-100" disabled>
                            Aucune commande
                        </button>
                    {% endif %}
                </div>
            </div>
        </div>
    {% endfor %}
</div>

<div class="mt-4">
    <a href="{{ path('commande_index') }}" class="btn btn-secondary">
        <i class="fas fa-arrow-left"></i> Retour aux commandes
    </a>
</div>
{% endblock %}
